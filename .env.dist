# DOCKER-COMPOSE
POSTGRES_PORT=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

MINIO_USER=
MINIO_PASSWORD=

PG_PROXY_PORT=
PG_PROXY_PASSWORD=

FRONTEND_PORT=
ELECTRIC_PORT=
ADMINER_PORT=

COMPOSE_PROFILES=

# BACKEND
HTTP_PORT=
JWT_SECRET=
DATABASE_URL=
FRONTEND_URL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ENDPOINT=

MINIO_URL=
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_KEY=
SENTRY_DSN=

# UNITÉS PATRIMONIALES (API dataspace, joignable uniquement depuis le réseau de prod)
# mock = données de packages/backend/src/features/up/fixtures/up-mock.json ; live = appel réel (UP_API_KEY obligatoire)
UP_API_MODE=mock
UP_API_URL=https://api-ext.stg.cloud.culture.fr/dataspace/patrinote/up
UP_API_KEY=
UP_CACHE_TTL_HOURS=24

# FRONTEND
VITE_BACKEND_URL=
VITE_ELECTRIC_URL=
VITE_SENTRY_DSN=

# AUTH (sessions issued by the backend)
# RS256 key signing the access tokens, required in production: pnpm backend auth:generate-key
AUTH_JWT_PRIVATE_KEY=
# PowerSync reads the public keys there (dev: the backend runs on the host)
PS_JWKS_URI=http://host.docker.internal:3001/api/auth/jwks.json
# how long an agent may stay offline without syncing before signing in again
AUTH_SESSION_IDLE_DAYS=90

# PROCONNECT (disabled when PROCONNECT_CLIENT_ID is empty)
# integration: fca.integ01.dev-agentconnect.fr — production: auth.agentconnect.gouv.fr
PROCONNECT_DOMAIN=fca.integ01.dev-agentconnect.fr
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=
